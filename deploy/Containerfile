ARG NODE_VERSION=26.4.0
ARG VERSION=1.0.0

FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci

FROM deps AS build
COPY public ./public
RUN npm exec -- esbuild public/app.ts \
    --outfile=public/app.js \
    --bundle \
    --format=esm \
    --target=esnext \
    --minify

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ARG VERSION=1.0.0
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000
LABEL org.opencontainers.image.title="HallucyGenie" \
      org.opencontainers.image.description="Kid-friendly MiniMax creative web UI" \
      org.opencontainers.image.source="https://github.com/bugabinga/hallucygenie" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node src ./src
COPY --chown=node:node migrations ./migrations
COPY --chown=node:node public ./public
COPY --from=build --chown=node:node /app/public/app.js ./public/app.js
RUN mkdir -p data logs && chown -R node:node data logs
USER node
EXPOSE 3000
CMD ["node", "src/server.ts"]
