{
    "name": "hallucygenie",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "packageManager": "bun@1.3.13",
    "scripts": {
        "build": "bunx esbuild public/app.ts --outfile=public/app.js --bundle --format=esm --target=esnext",
        "dev": "bun run build && bun src/server.ts",
        "hooks:install": "lefthook install",
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install",
        "test": "bun test test/*.test.ts",
        "test:coverage": "bun test --coverage test/*.test.ts",
        "test:mutation": "stryker run test/stryker.config.mjs"
    },
    "devDependencies": {
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/typescript-checker": "^9.6.1",
        "@types/bun": "^1.3.13",
        "@types/nock": "^10.0.3",
        "@types/node": "^25.6.0",
        "esbuild": "^0.28.0",
        "lefthook": "^2.1.6",
        "happy-dom": "15",
        "nock": "^14.0.12",
        "playwright-core": "^1.59.1",
        "prettier": "^3.8.0",
        "prettier-plugin-sql": "^0.20.0"
    },
    "dependencies": {
        "marked": "15.0.4"
    }
}
