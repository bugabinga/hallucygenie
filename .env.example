# Required for chat, image, voice, video, search, quota, and image analysis.
# Explore/Build includes H3; music/lyrics additionally require legacy provider access.
# App uses this key only; no automatic PAYG fallback.
MINIMAX_API_KEY=

# HTTP port inside local dev or container.
PORT=3000

# Optional sidecar for YouTube-to-audio cover-song preprocessing.
# Leave blank to keep YouTube cover input disabled.
COVER_EXTRACTOR_URL=
