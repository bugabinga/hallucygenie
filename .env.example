# Required for chat, lyrics, image, voice, video, search, quota, and media inspection.
# Stored speech uses ASR; stored video inspection combines visual analysis with ASR.
# Explore/Build includes H3; music audio and covers are temporarily disabled.
# App uses this key only; no automatic PAYG fallback.
MINIMAX_API_KEY=

# HTTP port inside local dev or container.
PORT=3000

# Reserved sidecar setting; cover preprocessing is currently disabled.
COVER_EXTRACTOR_URL=
